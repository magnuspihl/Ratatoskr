# Copy to .env and fill in real values. Never commit .env.

# Public URL the app is served from (used for OIDC redirects, cookies and WebSocket origin checks).
RATATOSKR_BASE_URL=https://mail.example.com

# Master key for encrypting stored account passwords and session cookies.
# At least 32 characters. Generate with: openssl rand -base64 48
# Changing it makes all stored account passwords unreadable (users must re-enter them).
RATATOSKR_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars

# Generic OpenID Connect provider (Authentik, Keycloak, ...).
# Redirect URI to register at the provider: ${RATATOSKR_BASE_URL}/auth/callback
OIDC_ISSUER_URL=https://auth.example.com/application/o/ratatoskr/
OIDC_CLIENT_ID=ratatoskr
OIDC_CLIENT_SECRET=change-me
# OIDC_SCOPES=openid email profile

# Set to true when running behind a reverse proxy that sets X-Forwarded-* headers.
# RATATOSKR_TRUST_PROXY=true

# Optional tuning
# PORT=8080
# RATATOSKR_DATA_DIR=./data
# RATATOSKR_BLOCK_PRIVATE_MAIL_HOSTS=false
# RATATOSKR_IMAP_IDLE_TIMEOUT=300
# RATATOSKR_MAX_MESSAGE_MB=50
# RATATOSKR_MAX_UPLOAD_MB=25
# Contact sent to push services with notifications (mailto: or https: URL).
# Defaults to RATATOSKR_BASE_URL when it is https.
# RATATOSKR_VAPID_SUBJECT=mailto:admin@example.com
# LOG_LEVEL=info

# Development only (ignored when NODE_ENV=production): log in without OIDC as a local dev user.
# RATATOSKR_DEV_LOGIN=true
# Development only (ignored in production and by the production build): also let the dev server
# answer on any host ending in this suffix, e.g. one reverse-proxied hostname per port
# (5173--myworkspace--me.dev.example.com, 40140--myworkspace--me.dev.example.com, ...).
# Must start with "." or "--". OIDC logins still return to RATATOSKR_BASE_URL.
# RATATOSKR_DEV_ALLOWED_HOST_SUFFIX=--myworkspace--me.dev.example.com
