{
  "name": "ratatoskr",
  "version": "0.1.0",
  "private": true,
  "description": "A simple, good-looking, self-hosted webmail client for any IMAP/SMTP account.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev.mjs",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/server/server/src/index.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^12.0.0",
    "imapflow": "^2.5.2",
    "ipaddr.js": "^2.5.0",
    "nodemailer": "^10.1.2",
    "openid-client": "^6.8.8",
    "pino": "^10.4.0",
    "postal-mime": "^4.0.7",
    "postcss": "^8.5.30",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.3",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
